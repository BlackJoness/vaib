// vaib — Prisma Schema (PostgreSQL / Supabase)
// Loja de um produto: o produto pode ser físico ou serviço, e suas opções
// (tamanho, cor, plano, prazo...) são dados, não enum. Ver docs/adr/0002.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Físico tem estoque e entrega; serviço tem agenda e contato.
enum ProductKind {
  PHYSICAL
  SERVICE
}

// Fechamento por contato (ADR 0001): o pedido nasce NOVO, o lojista entra em
// contato, confirma e conclui. CANCELADO vale de qualquer estado não final.
enum OrderStatus {
  NOVO
  EM_CONTATO
  CONFIRMADO
  CONCLUIDO
  CANCELADO
}

model Product {
  id        String      @id @default(cuid())
  slug      String      @unique
  nome      String
  tagline   String?
  descricao String?
  kind      ProductKind @default(PHYSICAL)
  precoBase Decimal     @db.Decimal(10, 2)
  ativo     Boolean     @default(true)
  // O produto exibido na home. O service garante no máximo um em destaque.
  destaque  Boolean     @default(false)
  // Seletores que a loja renderiza. Formato em src/products/product-content.types.ts
  options   Json        @default("[]")
  // Imagens e vídeos do produto: [{ url, alt, kind }]
  media     Json        @default("[]")
  // Textos de venda por seção (headline, benefícios, passos, FAQ, prova social)
  content   Json        @default("{}")
  variants  Variant[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([destaque])
}

model Variant {
  id            String      @id @default(cuid())
  sku           String      @unique // XPTO-CASA-EXPRESS
  // Combinação de opções: { "escopo": "casa", "entrega": "express" }
  attributes    Json        @default("{}")
  // Forma canônica de `attributes` ("entrega=express;escopo=casa", chaves ordenadas)
  // para a unicidade por produto, que o Postgres não faz sobre JSON.
  attributesKey String
  // null = sem controle de estoque (serviço ou ilimitado)
  estoque       Int?
  preco         Decimal     @db.Decimal(10, 2)
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId     String
  orderItems    OrderItem[]

  @@unique([productId, attributesKey])
  @@index([estoque])
  @@index([productId])
}

model Order {
  id              String      @id @default(cuid())
  numero          Int         @default(autoincrement())
  clienteNome     String
  clienteEmail    String
  clienteWhatsapp String? // só dígitos, com DDI e DDD
  clienteMensagem String? // preferência de horário, endereço, observação
  // Snapshot do tipo do produto no momento do pedido
  fulfillmentType ProductKind @default(PHYSICAL)
  status          OrderStatus @default(NOVO)
  total           Decimal     @db.Decimal(10, 2)
  items           OrderItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id            String  @id @default(cuid())
  order         Order   @relation(fields: [orderId], references: [id])
  orderId       String
  variant       Variant @relation(fields: [variantId], references: [id])
  variantId     String
  // Snapshot legível: "XPTO · Casa completa · Express". Sobrevive a mudanças no produto.
  descricao     String  @default("")
  quantidade    Int
  precoUnitario Decimal @db.Decimal(10, 2)
}

// Usuário administrativo do dashboard. Não há cadastro público:
// o primeiro admin é criado pelo seed a partir de ADMIN_EMAIL e ADMIN_PASSWORD.
model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  senhaHash String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
