// Solê — Prisma Schema (PostgreSQL / Supabase)
// Produto genérico × Variantes (cor+tamanho) com estoque individual.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Grade têxtil fixa (restrição do projeto)
enum Tamanho {
  P
  M
  G
  GG
}

// Status de pedido permitidos (restrição do projeto)
enum OrderStatus {
  AGUARDANDO_PAGAMENTO
  EM_SEPARACAO
  ENVIADO
}

model Product {
  id        String    @id @default(cuid())
  slug      String    @unique
  nome      String
  descricao String?
  precoBase Decimal   @db.Decimal(10, 2)
  ativo     Boolean   @default(true)
  variants  Variant[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Variant {
  id         String      @id @default(cuid())
  sku        String      @unique // SOLE-BRISA-COR-P
  cor        String // "Coral Sol"
  corHex     String // "#FF7E67"
  tamanho    Tamanho // P | M | G | GG
  estoque    Int         @default(0) // estoque individual da variante
  preco      Decimal     @db.Decimal(10, 2)
  product    Product     @relation(fields: [productId], references: [id])
  productId  String
  orderItems OrderItem[]

  @@unique([productId, cor, tamanho]) // 1 variante por cor+tamanho
  @@index([estoque])
}

model Order {
  id           String      @id @default(cuid())
  numero       Int         @default(autoincrement())
  clienteNome  String
  clienteEmail String
  status       OrderStatus @default(AGUARDANDO_PAGAMENTO)
  total        Decimal     @db.Decimal(10, 2)
  items        OrderItem[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([status])
}

model OrderItem {
  id            String  @id @default(cuid())
  order         Order   @relation(fields: [orderId], references: [id])
  orderId       String
  variant       Variant @relation(fields: [variantId], references: [id])
  variantId     String
  quantidade    Int
  precoUnitario Decimal @db.Decimal(10, 2)
}
